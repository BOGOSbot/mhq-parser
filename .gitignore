# Credentials, cookies, session tokens — never commit these.
.secrets/
.env
*.env

# scratch: commit messages staged to a file, probe scripts
_msg*.txt
_*.ps1

# browser snapshots from playwright-cli runs
.playwright-cli/

# screenshots taken while checking the UI, and the local Vercel link.
# Neither belongs in the repo: both are per-machine.
*.png
.vercel/

# scratch scripts and generated copies from analysis runs
.scratch/

# the MFM reference cache verify-points.mjs fills: per-machine and
# re-fetchable, so it is never committed
.verify-ref/
.mfm/

# a hand-extraction scratch the tool replaced
.verify-inventory.json
